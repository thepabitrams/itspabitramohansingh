{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "its",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guestbook-db",
      "database_id": "ceba607b-37ef-4347-a4da-c79c78ac466b",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/**/*.sql"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "BETTER_AUTH_URL": "https://its.pabitramohansingh.workers.dev"
  }
}