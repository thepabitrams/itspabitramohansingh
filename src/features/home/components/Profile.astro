---
const profilePhotoSlides = [
  { src: '/profile/portrait-01.jpg', alt: 'Pabitra Mohan Singh' },
  { src: '/profile/portrait-02.jpg', alt: '' },
  { src: '/profile/portrait-03.jpg', alt: '' },
  { src: '/profile/portrait-04.jpg', alt: '' },
  { src: '/profile/portrait-05.jpg', alt: '' },
  { src: '/profile/portrait-06.jpg', alt: '' },
  { src: '/profile/portrait-07.jpg', alt: '' },
];
---

<div class="shrink-0">
  <div class="profile-photo">
    {profilePhotoSlides.map((profilePhoto, slideIndex) => (
      <img
        class="profile-photo__slide"
        src={profilePhoto.src}
        alt={profilePhoto.alt}
        loading={slideIndex === 0 ? 'eager' : 'lazy'}
        fetchpriority={slideIndex === 0 ? 'high' : undefined}
        aria-hidden={slideIndex > 0 ? 'true' : undefined}
      />
    ))}
  </div>
</div>