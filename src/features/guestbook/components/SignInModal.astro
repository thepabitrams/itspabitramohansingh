---
import Icon from './ui/Icon.astro';
import ProviderButton from './ui/ProviderButton.astro';
---
<div id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" hidden class="fixed inset-0 z-[80] grid place-items-center p-5 bg-black/40 transition-opacity duration-150 opacity-0 invisible">
  <div class="relative w-full max-w-[400px] border border-neutral-200 dark:border-neutral-800 rounded-[14px] bg-white dark:bg-neutral-900 pt-8 px-7 pb-[26px] shadow-2xl">
    <button id="modalClose" type="button" aria-label="Close" class="absolute top-3 right-3 w-8 h-8 grid place-items-center rounded-full bg-transparent text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-neutral-900 dark:hover:text-white transition-colors cursor-pointer">
      <Icon name="close" class="w-[15px] h-[15px]" />
    </button>
    <h2 id="modalTitle" class="text-[19px] font-semibold tracking-tight text-center text-neutral-900 dark:text-white m-0">Sign in</h2>
    <p class="mt-1.5 mb-6 text-center text-[13.5px] text-neutral-400 dark:text-neutral-500">Pick a provider to continue.</p>
    <div class="grid gap-2">
      <ProviderButton provider="google" label="Continue with Google" />
      <ProviderButton provider="github" label="Continue with GitHub" />
    </div>
    <p class="mt-5 text-center text-[11.5px] leading-[1.5] text-neutral-400 dark:text-neutral-500">
      Keep it kind. We store only your name, avatar, and what you write.
    </p>
  </div>
</div>

<script>
  import { setupSignInModal } from '../scripts/signin-modal';
  setupSignInModal();
</script>