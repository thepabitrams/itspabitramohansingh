---
export interface Props {
  variant?: 'elevated' | 'flat';
  padding?: 'none' | 'sm' | 'md' | 'bar';
  class?: string;
  id?: string;
}

const {
  variant = 'elevated',
  padding = 'none',
  class: className = '',
  id,
} = Astro.props;

const baseClasses = 'bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden';

const variantClasses = {
  elevated: 'shadow-sm hover:shadow-md transition-all duration-200',
  flat: '',
};

const paddingClasses = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  bar: 'px-5 py-[18px]',
};

const classes = `${baseClasses} ${variantClasses[variant]} ${paddingClasses[padding]} ${className}`;
---

<div class={classes} id={id}>
  <slot />
</div>