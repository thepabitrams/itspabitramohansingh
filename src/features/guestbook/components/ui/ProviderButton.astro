---
interface Props {
  provider: 'google' | 'github';
  label: string;
}
const { provider, label } = Astro.props;
---
<button
  type="button"
  data-provider={provider}
  class="provider flex items-center gap-3 h-12 px-4 border border-neutral-300 dark:border-neutral-700 rounded-md bg-white dark:bg-neutral-900 text-sm font-medium text-neutral-900 dark:text-neutral-100 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors text-left w-full cursor-pointer"
>
  { provider === 'google' && (
    <svg class="w-[18px] h-[18px] shrink-0 text-neutral-600 dark:text-neutral-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 11v2.9h4.1c-.2 1.1-1.4 3.2-4.1 3.2-2.5 0-4.5-2-4.5-4.6S9.5 8 12 8c1.4 0 2.4.6 2.9 1.1l2-1.9C15.6 6 13.9 5.2 12 5.2 7.9 5.2 4.6 8.5 4.6 12.6S7.9 20 12 20c3.9 0 6.5-2.7 6.5-6.6 0-.4 0-.8-.1-1.1H12z"/>
    </svg>
  ) }
  { provider === 'github' && (
    <svg class="w-[18px] h-[18px] shrink-0 text-neutral-600 dark:text-neutral-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2C6.5 2 2 6.6 2 12.2c0 4.5 2.9 8.3 6.8 9.6.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.4-3.4-1.4-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.8 1 .8-.2 1.6-.3 2.5-.3s1.7.1 2.5.3c2-1.3 2.8-1 2.8-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7 1 .7 2v2.9c0 .3.2.6.7.5A10.1 10.1 0 0 0 22 12.2C22 6.6 17.5 2 12 2z"/>
    </svg>
  ) }
  <span>{label}</span>
  <span class="ml-auto text-neutral-400" aria-hidden="true">→</span>
</button>