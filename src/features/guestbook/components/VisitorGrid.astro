---
import Card from './ui/Card.astro';
---
<Card variant="flat" padding="none" class="h-[440px] max-md:h-[400px] max-[520px]:h-[380px] flex flex-col">
  <aside aria-label="Visitors" class="flex flex-col h-full min-h-0">
    <div class="shrink-0 flex items-center justify-between gap-3 px-4 py-3 border-b border-neutral-200 dark:border-neutral-800">
      <h2 class="text-[13px] font-semibold tracking-tight text-neutral-900 dark:text-white m-0">Visitors</h2>
    </div>
    <div id="visitorGrid" role="list" class="flex-1 min-h-0 overflow-y-auto px-3.5 pt-4 pb-[18px] grid grid-cols-3 gap-x-2.5 gap-y-[18px] content-start"></div>
  </aside>
</Card>

<script>
  import { setupVisitorGrid } from '../scripts/visitor-grid';
  setupVisitorGrid();
</script>