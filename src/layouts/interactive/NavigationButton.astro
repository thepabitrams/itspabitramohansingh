---
interface Props {
  href: string;
  label: string;
  isActive?: boolean;
}
const { href, label, isActive = false } = Astro.props;
---

<a
  href={href}
  class:list={['navigation-button', { 'is-active': isActive }]}
  aria-current={isActive ? 'page' : undefined}
>
  <span class="navigation-button__icon"><slot /></span>
  <span>{label}</span>
</a>