---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bio from '../features/home/components/Bio.astro';
import Profile from '../features/home/components/Profile.astro';
import About from '../features/home/components/About.astro';
import Socials from '../features/home/components/Socials.astro';
---

<BaseLayout title="Pabitra Mohan Singh – MS Computer Science Student">
  <section class="py-16 md:py-24 max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col-reverse md:flex-row items-center gap-12 md:gap-16">
      <div class="flex-1 animate-slide-in-left animate-delay-100">
        <Bio />
      </div>
      <div class="animate-slide-in-right animate-delay-200">
        <Profile />
      </div>
    </div>

    <div class="mt-12 flex justify-center md:justify-start animate-slide-in-left animate-delay-300">
      <Socials />
    </div>

    <div class="mt-16 animate-slide-in-up animate-delay-400">
      <About />
    </div>
  </section>
</BaseLayout>