---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Guestbook" description="Sign the guestbook.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-20">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">Guestbook</h1>
    <p class="text-neutral-600 dark:text-neutral-400 mb-10">
      Leave a message. This is a demo page for now — the form and storage will come later.
    </p>

    <div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 p-6">
      <p class="text-neutral-500 dark:text-neutral-400 text-sm">
        Guestbook entries will appear here once the backend is wired up.
      </p>
    </div>
  </section>
</BaseLayout>