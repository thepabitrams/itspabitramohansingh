---

<div class="social-links">
  {socialLinks.map((socialLink) => (
    <a
      href={socialLink.href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={['social-icon', `social-icon--${socialLink.modifier}`]}
      aria-label={socialLink.platform}
    >
      <span class="social-icon__tooltip">{socialLink.platform}</span>
      <span class="social-icon__inner" set:html={socialLink.iconSvg} />
    </a>
  ))}

  <a href="mailto:contactpabitrams@gmail.com" class="social-cta" aria-label="Say Hello">
    <span class="social-cta__icon" set:html={gmailSvg} />
    <span class="social-cta__label">Say Hello</span>
  </a>
</div>