---
const photos = [
  { src: '/profile/portrait-01.jpg', alt: 'Pabitra Mohan Singh' },
  { src: '/profile/portrait-02.jpg', alt: '' },
  { src: '/profile/portrait-03.jpg', alt: '' },
  { src: '/profile/portrait-04.jpg', alt: '' },
  { src: '/profile/portrait-05.jpg', alt: '' },
  { src: '/profile/portrait-06.jpg', alt: '' },
  { src: '/profile/portrait-07.jpg', alt: '' },
];
---

<div class="shrink-0 animate-slide-in-right animate-delay-200">
  <div class="profile-photo">
    {photos.map((photo, index) => (
      <img
        class="profile-photo__slide"
        src={photo.src}
        alt={photo.alt}
        loading={index === 0 ? 'eager' : 'lazy'}
        fetchpriority={index === 0 ? 'high' : undefined}
        aria-hidden={index > 0 ? 'true' : undefined}
      />
    ))}
  </div>
</div>